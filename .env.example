# Copy to .env and fill in. .env is git-ignored.

# Postgres connection string. On Vercel, the Neon integration sets this for you.
# Local example: postgres://USER:PASSWORD@localhost:5432/calorie_tracker
DATABASE_URL=

# Vercel AI Gateway key for photo analysis (https://vercel.com/docs/ai-gateway).
AI_GATEWAY_API_KEY=

# Optional: override the vision model used for photo analysis.
# AI_GATEWAY_MODEL=google/gemini-3.1-flash-lite

# Optional in development: Vercel Blob store token. Without it, photos are kept in .local-photos/.
# BLOB_READ_WRITE_TOKEN=

# Password reset emails (https://resend.com). In development without a key, the reset link is
# printed to the server log instead of being sent.
# RESEND_API_KEY=
# EMAIL_FROM=CAL-c <no-reply@yourdomain.com>
# Optional: public site URL used in reset links. Defaults to the request's own origin.
# APP_URL=
